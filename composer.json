{
    "name": "wlindabla/user-bundle",
    "description": "Reusable Symfony 6.4/7.4/8 user bundle (PHP 8.3+) with a ready-made security layer: login, email verification, password reset and temporary passwords, email-code two-factor authentication (2FA), single-session policy, login history, business permissions and double-confirmed email changes. SonataAdmin-friendly, PostgreSQL-first, with overridable repositories.",
    "type": "symfony-bundle",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "AGBOKOUDJO Franck",
            "email": "internationaleswebservices@gmail.com"
        }
    ],
    "keywords": ["symfony", "symfony-bundle", "user", "security", "authentication", "2fa", "two-factor", "session", "password-reset", "email-verification", "sonata-admin", "doctrine", "postgresql"],
    "homepage": "https://github.com/Agbokoudjo/user-bundle",
    "support": {
        "issues": "https://github.com/Agbokoudjo/user-bundle/issues",
        "source": "https://github.com/Agbokoudjo/user-bundle",
        "docs": "https://github.com/Agbokoudjo/user-bundle/tree/main/docs"
    },
    "require": {
        "php": ">=8.3",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/security-core": "^6.4|^7.4|^8.0",
        "symfony/security-bundle": "^6.4|^7.4|^8.0",
        "symfony/validator": "^6.4|^7.4|^8.0",
        "symfony/rate-limiter": "^6.4|^7.4|^8.0",
        "symfony/lock": "^6.4|^7.4|^8.0",
        "symfony/twig-bundle": "^6.4|^7.4|^8.0",
        "symfony/translation": "^6.4|^7.4|^8.0",
        "symfony/messenger": "^6.4|^7.4|^8.0",
        "symfony/serializer": "^6.4|^7.4|^8.0",
        "symfony/password-hasher": "^6.4|^7.4|^8.0",
        "doctrine/orm": "^3.0",
        "doctrine/doctrine-bundle": "^2.11|^3.0",
        "wlindabla/share-service-bundle": "^1.0",
        "wlindabla/mailing-bundle": "^1.0",
        "vich/uploader-bundle": "^3.0",
        "odolbeau/phone-number-bundle": "^4.2",
        "symfony/console": "^6.4|^7.4|^8.0",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/cache": "^6.4|^7.4|^8.0",
        "symfony/framework-bundle": "^6.4|^7.4|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.4|^8.0",
        "symfony/http-foundation": "^6.4|^7.4|^8.0",
        "symfony/routing": "^6.4|^7.4|^8.0",
        "symfony/mailer": "^6.4|^7.4|^8.0",
        "scienta/doctrine-json-functions": "^6.0"
    },
    "autoload": {
    "psr-4": { "Wlindabla\\UserBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Wlindabla\\UserBundle\\Tests\\": "tests/" }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
    "symfony/scheduler": "To automatically clean up expired user sessions (Infrastructure/Scheduler/SessionCleanupSchedule)."
}
}

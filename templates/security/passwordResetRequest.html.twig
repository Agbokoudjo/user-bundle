{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — eQapitalise | CERRHUD{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    {{ vite_entry_link_tags('login', [], 'admin') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('login', [], 'admin') }}
    {{ vite_entry_script_tags('form', [], 'admin') }}
{% endblock %}

{% block body %}
<div class="login-page">

    <div class="login-bg" style="background-image: url({{ asset('assets/images/login_bg.png','admin') }});">
        <div class="login-overlay"></div>
    </div>

    <div class="login-wrapper">
        <div class="login-card">

            <div class="login-header">
                <img src="{{ asset('assets/images/logo.png','admin') }}"
                     alt="eQapitalise — CERRHUD"
                     class="login-logo">
                <h1 class="login-title">Mot de passe oublié</h1>
                <em class="login-subtitle">Recevez un lien de confirmation par email</em>
                <div class="login-divider"></div>
            </div>

            {% include 'bundles/SonataTwigBundle/FlashMessage/render.html.twig' %}

            <p style="text-align:center; color:#6c757d; font-size:0.9rem; margin-bottom:20px;">
                Saisissez l'adresse email associée à votre compte. Nous vous enverrons un lien
                pour confirmer votre demande, puis un mot de passe temporaire vous sera envoyé
                par email.
            </p>

            {{ form_start(form, {'attr': {'class': 'login-form form-validate', 'autocomplete': 'off'}}) }}
                <div class="login-field">
                    <label for="{{ form.username.vars.id }}" class="login-label">
                        {{ ux_icon('fa:envelope') }}
                        Adresse email
                    </label>
                    {{ form_widget(form.username) }}
                    {{ form_errors(form.username) }}
                </div>

                <button type="submit" class="login-btn">
                    <span class="login-btn-text">Envoyer le lien de confirmation</span>
                    {{ ux_icon('fa:arrow-right', {class: 'login-btn-icon'}) }}
                </button>
            {{ form_end(form) }}

            <div class="login-card-footer">
                <a href="{{ path('app_admin_user_login') }}" class="login-request-account-link">
                    {{ ux_icon('fa:arrow-left') }}
                    Retour à la connexion
                </a>
            </div>

        </div>

        <div class="login-page-footer">
            <span>© {{ "now"|date("Y") }} CERRHUD</span>
            <span class="login-footer-dot">•</span>
            <span>Cotonou, Bénin</span>
        </div>
    </div>
</div>
{% endblock %}

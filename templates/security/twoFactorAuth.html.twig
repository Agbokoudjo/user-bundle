 * email). Étend base.html.twig — volontairement PAS le layout SonataAdmin,
 * puisque l'utilisateur n'est pas encore pleinement autorisé à voir le
 * tableau de bord tant que ce code n'est pas validé.
#}
{% extends 'base.html.twig' %}

{% block title %}Vérification en deux étapes — eQapitalise | CERRHUD{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    {{ vite_entry_link_tags('two_factor', [], 'admin') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('two_factor', [], 'admin') }}
    {{ vite_entry_script_tags('form', [], 'app') }}
{% endblock %}

{% block body %}
<div class="app-frontend two-factor-page">

    <div class="two-factor-bg" style="background-image: url({{ asset('assets/images/login_bg.png','admin') }});">
        <div class="two-factor-overlay"></div>
    </div>

    <div class="two-factor-wrapper">
        <div class="two-factor-card">

            <div class="two-factor-header">
                <img src="{{ asset('assets/images/logo.png','admin') }}"
                     alt="eQapitalise — CERRHUD"
                     class="two-factor-logo">
                <div class="two-factor-icon"><i class="bi bi-shield-fill-exclamation"></i></div>
                <h1 class="two-factor-title">Vérification en deux étapes</h1>
                <em class="two-factor-subtitle">
                    Un code de vérification vient d'être envoyé par email à
                    <strong>{{ username }}</strong>.
                </em>
                <div class="two-factor-divider"></div>
            </div>

            {% include 'bundles/SonataTwigBundle/FlashMessage/render.html.twig' %}

            <p class="two-factor-hint">
                Saisissez le code reçu (chiffres et lettres, sans espace). Il expire dans
                <strong>10 minutes</strong>.
            </p>

            <form id="two-factor-form"
                  name="two_factor_form"
                  class="two-factor-form form-validate"
                  method="post"
                  action="{{ path('app_two_factor_verify') }}"
                  autocomplete="off">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('two_factor_verify') }}">
                <div class="two-factor-field">
                    <label for="two_factor_code" class="two-factor-label">
                        <i class="bi bi-key"></i>
                        Code de vérification
                    </label>
                    <input
                        type="text"
                        id="two_factor_code"
                        name="code"
                        class="two-factor-input"
                        inputmode="text"
                        data-type="text"
                        autocomplete="one-time-code"
                        maxlength="20"
                        minlength="20"
                        pattern="^[0-9A-Z]{20}$"
                        data-pattern="^[0-9A-Z]{20}$"
                        placeholder="Ex. 4K7B2Q9138045T1XW26"
                        required
                        autofocus
                    >
                    <div class="container-div-error-message"></div>
                </div>

                <button type="submit" class="two-factor-btn">
                    <span class="two-factor-btn-text">Valider le code</span>
                </button>
            </form>

            <div class="two-factor-resend">
                <span>Vous n'avez rien reçu ?</span>
                <button type="button" id="two-factor-resend-btn" class="two-factor-resend-btn"
                        data-resend-url="{{ path('app_two_factor_resend') }}"
                        data-csrf-token="{{ csrf_token('two_factor_resend') }}">
                    Renvoyer le code
                </button>
                <span id="two-factor-resend-countdown" class="two-factor-resend-countdown"></span>
            </div>

            <div class="two-factor-footer">
                <a href="{{ path('sonata_user_admin_security_logout') }}" class="two-factor-logout-link">
                   <i class="bi bi-box-arrow-right"></i>
                    Annuler et se déconnecter
                </a>
            </div>

        </div>
    </div>
</div>
{% endblock %}

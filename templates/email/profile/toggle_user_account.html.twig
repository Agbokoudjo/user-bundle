<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'toggle_account_email.page_title'|trans({}, 'WlindablaUserBundle') }}</title>
</head>
<body>
    {% set is_active = status == true %}
    {% set color = is_active ? '#039855' : '#E03C31' %}
    {% set status_key = is_active ? 'toggle_account_email.status_active' : 'toggle_account_email.status_inactive' %}

    <div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">

        <p style="font-size: 16px;">
            {{ 'toggle_account_email.greeting'|trans({'%username%': username}, 'WlindablaUserBundle') }}
        </p>

        <h1 style="color: {{ color }}; font-size: 24px; text-align: center; border-bottom: 2px solid {{ color }}; padding-bottom: 10px;">
            {{ 'toggle_account_email.heading'|trans({'%status%': status_key|trans({}, 'WlindablaUserBundle')}, 'WlindablaUserBundle') }}
        </h1>

        {% if is_active %}
            <p>{{ 'toggle_account_email.body_active'|trans({'%site_name%': site_name, '%status%': status_key|trans({}, 'WlindablaUserBundle')}, 'WlindablaUserBundle') }}</p>

            <p>{{ 'toggle_account_email.login_intro'|trans({}, 'WlindablaUserBundle') }}</p>

            {% if password_user is defined and password_user is not empty %}
                <div style="background-color: #f0f8ff; border-left: 4px solid {{ color }}; padding: 15px; margin: 20px 0;">
                    <p style="margin: 0; font-size: 14px;">
                        <strong>{{ 'toggle_account_email.temp_password_label'|trans({}, 'WlindablaUserBundle') }}</strong><br>
                        <span style="background-color: #e8e8e8; padding: 5px 10px; border-radius: 3px; font-size: 16px; font-family: 'Courier New', monospace;">{{ password_user }}</span>
                    </p>
                </div>
                <p style="color: #d9534f; font-weight: bold;">
                    {{ 'toggle_account_email.temp_password_notice'|trans({}, 'WlindablaUserBundle')|raw }}
                </p>
            {% endif %}

            <div style="text-align: center; margin: 25px 0;">
                <a href="{{ url_login }}"
                   style="background-color: {{ color }};
                          color: #ffffff;
                          padding: 12px 25px;
                          text-decoration: none;
                          border-radius: 5px;
                          font-weight: bold;
                          display: inline-block;">
                    {{ 'toggle_account_email.login_button'|trans({}, 'WlindablaUserBundle') }}
                </a>
            </div>
        {% else %}
            <p style="color: #666;">
                {{ 'toggle_account_email.body_inactive'|trans({'%site_name%': site_name, '%status%': status_key|trans({}, 'WlindablaUserBundle')}, 'WlindablaUserBundle') }}
            </p>

            <p>
                {{ 'toggle_account_email.contact_admins'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </p>
        {% endif %}

        <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 30px 0;">

        <p style="font-size: 12px; color: #888;">
            {{ 'toggle_account_email.footer_note'|trans({}, 'WlindablaUserBundle') }}
        </p>
    </div>
</body>
</html>
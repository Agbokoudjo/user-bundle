<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ (approved ? 'email_change.outcome_approved_subject' : 'email_change.outcome_rejected_subject')|trans({'%site_name%': site_name}, 'WlindablaUserBundle') }}</title>
</head>
<body>
    {% set primary_color = approved ? '#0ec5b2' : '#c0392b' %}
    {% set border_color = '#DDDDDD' %}
    {% set accent_bg = approved ? '#E8F5E9' : '#FBEAE9' %}
    {% set accent_border = approved ? '#2E7D32' : '#C0392B' %}

    <div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid {{ border_color }}; border-radius: 8px;">

        <div style="text-align: center; padding-bottom: 20px; border-bottom: 1px solid {{ border_color }};">
            <h1 style="color: {{ primary_color }}; font-size: 24px; margin: 0;">
                {{ (approved ? 'email_change.outcome_approved_title' : 'email_change.outcome_rejected_title')|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </h1>
        </div>

        <div style="padding: 20px 0;">
            <p style="font-size: 16px; margin-bottom: 20px;">
                {{ 'email_change.greeting'|trans({'%username%': requested_by_username}, 'WlindablaUserBundle') }}
            </p>

            <p style="background-color: {{ accent_bg }}; padding: 15px; border-left: 4px solid {{ accent_border }}; margin-bottom: 25px;">
                {{ (approved ? 'email_change.outcome_approved_body' : 'email_change.outcome_rejected_body')|trans({'%target_username%': target_username}, 'WlindablaUserBundle')|raw }}
            </p>

            <p style="margin-bottom: 20px;">
                {{ 'email_change.outcome_details_notice'|trans({}, 'WlindablaUserBundle') }}
            </p>
        </div>

        <div style="border-top: 1px solid {{ border_color }}; padding-top: 15px; text-align: center;">
            <p style="font-size: 12px; color: #888;">
                {{ 'email_change.footer'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </p>
        </div>
    </div>
</body>
</html>
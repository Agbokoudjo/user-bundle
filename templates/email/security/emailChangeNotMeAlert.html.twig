<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email_change.not_me_alert_subject'|trans({'%site_name%': site_name}, 'WlindablaUserBundle') }}</title>
</head>
<body>
    {% set danger_color = '#c0392b' %}
    {% set border_color = '#DDDDDD' %}
    {% set danger_bg = '#FBEAE9' %}

    <div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid {{ border_color }}; border-radius: 8px;">

        <div style="text-align: center; padding-bottom: 20px; border-bottom: 1px solid {{ border_color }};">
            <h1 style="color: {{ danger_color }}; font-size: 24px; margin: 0;">
                ⚠️ {{ 'email_change.not_me_alert_title'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </h1>
        </div>

        <div style="padding: 20px 0;">
            <p style="font-size: 16px; margin-bottom: 20px;">{{ 'email_change.greeting_plain'|trans({}, 'WlindablaUserBundle') }}</p>

            <p style="background-color: {{ danger_bg }}; padding: 15px; border-left: 4px solid {{ danger_color }}; margin-bottom: 25px;">
                {{ 'email_change.not_me_alert_body'|trans({}, 'WlindablaUserBundle')|raw }}
            </p>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
                <tr>
                    <td style="padding: 8px; border: 1px solid {{ border_color }}; font-weight: bold; background-color: #F5F5F5;">{{ 'email_change.table_target_account'|trans({}, 'WlindablaUserBundle') }}</td>
                    <td style="padding: 8px; border: 1px solid {{ border_color }};">{{ target_username }} (ID: {{ target_user_id }})</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid {{ border_color }}; font-weight: bold; background-color: #F5F5F5;">{{ 'email_change.table_requested_by'|trans({}, 'WlindablaUserBundle') }}</td>
                    <td style="padding: 8px; border: 1px solid {{ border_color }};">{{ requested_by_username }}</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid {{ border_color }}; font-weight: bold; background-color: #F5F5F5;">{{ 'email_change.table_old_email'|trans({}, 'WlindablaUserBundle') }}</td>
                    <td style="padding: 8px; border: 1px solid {{ border_color }};">{{ old_email }}</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid {{ border_color }}; font-weight: bold; background-color: #F5F5F5;">{{ 'email_change.table_new_email_requested'|trans({}, 'WlindablaUserBundle') }}</td>
                    <td style="padding: 8px; border: 1px solid {{ border_color }};">{{ new_email }}</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid {{ border_color }}; font-weight: bold; background-color: #F5F5F5;">{{ 'email_change.table_requested_at'|trans({}, 'WlindablaUserBundle') }}</td>
                    <td style="padding: 8px; border: 1px solid {{ border_color }};">{{ requested_at|date('d/m/Y H:i', 'UTC') }} (UTC)</td>
                </tr>
            </table>

            <p style="margin-bottom: 20px;">
                {{ 'email_change.not_me_alert_footer_notice'|trans({}, 'WlindablaUserBundle') }}
            </p>
        </div>

        <div style="border-top: 1px solid {{ border_color }}; padding-top: 15px; text-align: center;">
            <p style="font-size: 12px; color: #888;">
                {{ 'email_change.footer'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </p>
        </div>
    </div>
</body>
</html>
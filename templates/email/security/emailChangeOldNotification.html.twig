<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email_change.old_notification_subject'|trans({'%site_name%': site_name}, 'WlindablaUserBundle') }}</title>
</head>
<body>
    {% set primary_color = '#0ec5b2' %}
    {% set danger_color = '#c0392b' %}
    {% set border_color = '#DDDDDD' %}
    {% set accent_color = '#F5F5F5' %}
    {% set danger_bg = '#FBEAE9' %}

    <div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid {{ border_color }}; border-radius: 8px;">

        <div style="text-align: center; padding-bottom: 20px; border-bottom: 1px solid {{ border_color }};">
            <h1 style="color: {{ primary_color }}; font-size: 24px; margin: 0;">
                {{ 'email_change.old_notification_title'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </h1>
        </div>

        <div style="padding: 20px 0;">
            <p style="font-size: 16px; margin-bottom: 20px;">
                {{ 'email_change.greeting'|trans({'%username%': target_username}, 'WlindablaUserBundle') }}
            </p>

            <p style="margin-bottom: 20px;">
                {% if requested_by_username is not null and requested_by_username != target_username %}
                    {{ 'email_change.old_notification_body_by_other'|trans({'%site_name%': site_name, '%requested_by%': requested_by_username, '%new_email%': new_email}, 'WlindablaUserBundle')|raw }}
                {% else %}
                    {{ 'email_change.old_notification_body_self'|trans({'%site_name%': site_name, '%new_email%': new_email}, 'WlindablaUserBundle')|raw }}
                {% endif %}
            </p>

            <p style="background-color: {{ accent_color }}; padding: 15px; border-left: 4px solid {{ primary_color }}; margin-bottom: 25px;">
                {{ 'email_change.old_notification_action_notice'|trans({}, 'WlindablaUserBundle')|raw }}
            </p>

            <div style="text-align: center; margin: 25px 0;">
                <a href="{{ confirmation_url }}"
                   style="background-color: {{ primary_color }};
                          color: #ffffff !important;
                          text-decoration: none;
                          padding: 15px 30px;
                          border-radius: 5px;
                          font-weight: bold;
                          display: inline-block;
                          font-size: 16px;">
                    {{ 'email_change.confirm_cta'|trans({}, 'WlindablaUserBundle') }}
                </a>
            </div>

            <p style="background-color: {{ danger_bg }}; padding: 15px; border-left: 4px solid {{ danger_color }}; margin-bottom: 25px;">
                {{ 'email_change.not_me_notice'|trans({}, 'WlindablaUserBundle')|raw }}
            </p>

            <div style="text-align: center; margin: 25px 0;">
                <a href="{{ not_me_url }}"
                   style="color: {{ danger_color }} !important;
                          text-decoration: underline;
                          font-weight: bold;
                          font-size: 15px;">
                    {{ 'email_change.not_me_cta'|trans({}, 'WlindablaUserBundle') }}
                </a>
            </div>

            <p style="font-size: 14px; margin-top: 30px; color: #666;">
                {{ 'email_change.link_expiry_notice'|trans({'%date%': expires_at|date('d/m/Y H:i', 'UTC')}, 'WlindablaUserBundle') }}
            </p>
            <p style="font-size: 12px; word-break: break-all; color: {{ primary_color }};">
                {{ confirmation_url }}
            </p>
        </div>

        <div style="border-top: 1px solid {{ border_color }}; padding-top: 15px; text-align: center;">
            <p style="font-size: 12px; color: #888;">
                {{ 'email_change.footer'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </p>
        </div>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'email_change.applied_subject'|trans({'%site_name%': site_name}, 'WlindablaUserBundle') }}</title>
</head>
<body>
    {% set primary_color = '#0ec5b2' %}
    {% set border_color = '#DDDDDD' %}
    {% set accent_color = '#F5F5F5' %}
    {% set danger_color = '#c0392b' %}
    {% set danger_bg = '#FBEAE9' %}

    <div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid {{ border_color }}; border-radius: 8px;">

        <div style="text-align: center; padding-bottom: 20px; border-bottom: 1px solid {{ border_color }};">
            <h1 style="color: {{ primary_color }}; font-size: 24px; margin: 0;">
                {{ 'email_change.applied_title'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </h1>
        </div>

        <div style="padding: 20px 0;">
            <p style="font-size: 16px; margin-bottom: 20px;">
                {{ 'email_change.greeting'|trans({'%username%': target_username}, 'WlindablaUserBundle')|raw  }}
            </p>

            <p style="margin-bottom: 20px;">
                {{ 'email_change.applied_body'|trans({'%site_name%': site_name, '%date%': applied_at|date('d/m/Y H:i', 'UTC'), '%new_email%': new_email}, 'WlindablaUserBundle')|raw }}
            </p>

            <p style="background-color: {{ accent_color }}; padding: 15px; border-left: 4px solid {{ primary_color }}; margin-bottom: 25px;">
                {{ 'email_change.applied_sessions_notice'|trans({}, 'WlindablaUserBundle') }}
            </p>

            <p style="background-color: {{ danger_bg }}; padding: 15px; border-left: 4px solid {{ danger_color }}; margin-bottom: 25px;">
                {{ 'email_change.applied_not_you_warning'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </p>
        </div>

        <div style="border-top: 1px solid {{ border_color }}; padding-top: 15px; text-align: center;">
            <p style="font-size: 12px; color: #888;">
                {{ 'email_change.footer'|trans({'%site_name%': site_name}, 'WlindablaUserBundle')|raw }}
            </p>
        </div>
    </div>
</body>
</html>